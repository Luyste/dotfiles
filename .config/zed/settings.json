// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": false,
  "edit_predictions": {
    "zed": {
      "prediction_debounce": 0,
    },
  },
  "format_on_save": "on",
  "disable_ai": false,
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
    "hide_gitignore": false,
    "default_width": 260, // px
  },
  // The agent terminal (tasks.json) opens on the right, like switchyard's viewer
  "terminal": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "left",
    "button": false, // the left dock is the file tree only, so cmd-e always shows it
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false, // the left dock is the file tree only, so cmd-e always shows it
  },
  "git_panel": {
    "dock": "left",
    "button": false, // the left dock is the file tree only, so cmd-e always shows it
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "agent": {
    "default_profile": "ask",
    "dock": "bottom", // the right dock is the terminal only, so cmd-j always shows it
    "default_model": {
      "provider": "anthropic",
      "model": "claude-opus-4-6",
      "enable_thinking": true,
      "effort": "medium",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Colored Zed Icons Theme Light",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "ui_font_size": 18,
  "ui_font_family": "IBM Plex Mono",
  "buffer_font_size": 18,
  "buffer_font_family": "IBM Plex Mono",
  "buffer_font_weight": 350,
  "buffer_line_height": "comfortable",
  "relative_line_numbers": "enabled",
  // nvim-like: no tabs or toolbar above the editor, the file in the status bar
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "status_bar": {
    "show_active_file": true,
    "cursor_position_button": true,
  },
  "title_bar": {
    "show_branch_name": true,
    "show_project_items": true,
  },
  "seed_search_query_from_cursor": "always",
  "theme": {
    "mode": "dark",
    "light": "Vague Light",
    "dark": "Vague Dark Deep",
  },
}
